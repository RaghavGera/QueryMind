# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=text_to_sql

# LLM providers (both OpenAI-compatible, both free without a payment method).
# Set a key for each provider you want in the failover chain; entries without
# a key are skipped. At least one key is required.
#
# Order in which chain entries are tried (default: gemini-lite,gemini-flash,groq).
# "gemini" is shorthand for gemini-lite,gemini-flash.
# LLM_PROVIDER_ORDER=gemini-lite,gemini-flash,groq

# Google AI Studio (Gemini): https://aistudio.google.com/apikey
# One key serves both Gemini entries (free-tier quotas are per model).
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_LITE_MODEL=gemini-3.1-flash-lite
# GEMINI_FLASH_MODEL=gemini-3.8-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=qwen/qwen3.8-27b

# Only for tests that spend real LLM tokens (python -m testing.run_tests --live)
# QUERYMIND_LIVE_LLM_TESTS=1

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
