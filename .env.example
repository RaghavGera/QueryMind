# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=text_to_sql
# Hosted Postgres (e.g. Neon) needs SSL: set DB_SSLMODE=require
# DB_SSLMODE=require

# LLM providers (both OpenAI-compatible, both free without a payment method).
# Set a key for each provider you want in the failover chain; entries without
# a key are skipped. At least one key is required.
#
# Order in which chain entries are tried (default: gemini-lite,groq,gemini-lite-alt,gemini-flash).
# "gemini" is shorthand for gemini-lite,gemini-flash.
# LLM_PROVIDER_ORDER=gemini-lite,groq,gemini-lite-alt,gemini-flash
#
# Seconds to wait for one LLM response before failing over (default 12).
# LLM_TIMEOUT_SECONDS=12

# Google AI Studio (Gemini): https://aistudio.google.com/apikey
# One key serves all three Gemini entries (free-tier quotas are per model).
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# GEMINI_LITE_ALT_MODEL=gemini-3.1-flash-lite
# GEMINI_FLASH_MODEL=gemini-3.8-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=qwen/qwen3.8-27b

# Only for tests that spend real LLM tokens (python -m testing.run_tests --live)
# QUERYMIND_LIVE_LLM_TESTS=1

# Sign in with Google. Both are needed, or nobody can sign in.
# GOOGLE_CLIENT_ID: the OAuth "Web application" client ID (public, not a secret).
# SESSION_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
SESSION_SECRET=generate_a_long_random_string
# Questions per UTC day: signed-in users / signed-out visitors (defaults 20 / 3)
# DAILY_QUESTION_LIMIT=20
# ANON_DAILY_QUESTION_LIMIT=3
# Visitor IP for the free-question count: a header the proxy sets itself.
# On Render: CLIENT_IP_HEADER=True-Client-IP (see SETUP.md). Unset locally.
# CLIENT_IP_HEADER=
# Fallback: X-Forwarded-For entries from the right (default 1)
# TRUSTED_PROXY_HOPS=1
# Header X-Service-Key with this value skips the daily limits (used by the eval)
# QUERYMIND_SERVICE_KEY=

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
