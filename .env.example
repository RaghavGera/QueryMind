# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=text_to_sql

# LLM providers (all OpenAI-compatible). Set a key for every provider you want
# in the failover chain; providers without a key are skipped. At least one is required.
#
# Order in which providers are tried (default: gemini,mistral,groq,openai).
# LLM_PROVIDER_ORDER=gemini,mistral,groq

# Google AI Studio (Gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Mistral La Plateforme: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=mistral-small-latest

# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=qwen/qwen3.8-27b

# OpenAI (optional, last in the default order)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Only for tests that spend real LLM tokens (python -m testing.run_tests --live)
# QUERYMIND_LIVE_LLM_TESTS=1

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
